{
  "name": "deno-solidjs-template",
  "version": "0.1.0",
  "exports": "./start.ts",
  "nodeModulesDir": "auto",
  "desktop": {
    "app": {
      "name": "Deno Solid App",
      "identifier": "com.example.deno-solid-app"
    },
    "backend": "webview"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@solidjs/web",
    "lib": ["deno.window", "dom", "dom.iterable", "deno.desktop"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "imports": {
    "#/": "./src/",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@orpc/contract": "npm:@orpc/contract@2.0.0-beta.35",
    "@orpc/server": "npm:@orpc/server@2.0.0-beta.35",
    "@solidjs/meta": "npm:@solidjs/meta@^1.0.0-next.2",
    "@solidjs/router": "npm:@solidjs/router@^2.0.0-next.21",
    "@solidjs/vite-plugin": "npm:@solidjs/vite-plugin@^3.0.0-next.38",
    "@solidjs/web": "npm:@solidjs/web@^2.0.0-rc.6",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "filesystem-routing": "npm:filesystem-routing@0.2.1",
    "solid-js": "npm:solid-js@^2.0.0-rc.6",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.1.5",
    "zod": "npm:zod@^4.6.1"
  },
  "tasks": {
    "dev": "deno run -A start.ts --dev",
    "build": "vite build",
    "build:desktop": "deno task build && deno desktop --output ./dist-desktop/DenoSolid --include dist --allow-net --allow-read --allow-write --allow-env --allow-sys --exclude-unused-npm start.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys start.ts",
    "dev:desktop": "DESKTOP_DEV=1 deno desktop -A --hmr --exclude-unused-npm start.ts",
    "serve": "vite preview",
    "check": "deno check src start.ts",
    "lint": "deno lint src start.ts"
  }
}
